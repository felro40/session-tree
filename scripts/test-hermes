#!/bin/sh
# Manage the isolated test Hermes (start | stop | status | ...). See scripts/e2e/test-hermes-cli.ts.
# Never touches ~/.hermes: the test home is ~/.cache/session-tree-e2e/c<card>-<role>/home (SESSION_TREE_CARD, default 3).
set -e
here=$(dirname "$0")
NODE=${NODE:-node}
if ! command -v "$NODE" >/dev/null 2>&1; then
  NODE=/home/david/.hermes/tools/node-26.12.1-linux-x64/bin/node
fi
exec "$NODE" "$here/e2e/test-hermes-cli.ts" "$@"
