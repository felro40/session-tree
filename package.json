{
  "name": "session-tree",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes Desktop/Webapp plugin: your chat sessions as an interactive branch graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/js/**/*.test.ts\"",
    "test:py": "sh scripts/run-pytest.sh",
    "test:e2e": "node scripts/e2e-foundation.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "es-module-lexer": "3.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
